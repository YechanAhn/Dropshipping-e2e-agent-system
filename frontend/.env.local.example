# Backend API base. Recommended: the browser calls the FastAPI backend DIRECTLY
# so its trailing-slash routes (/products/) don't trip the Next rewrite's
# slash-stripping 307 redirect. CORS is enabled server-side for localhost:3000/3001.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Fallback same-origin proxy target (used only if NEXT_PUBLIC_API_BASE is unset).
# The Next.js dev server forwards /api/* requests here.
API_PROXY_TARGET=http://localhost:8000
